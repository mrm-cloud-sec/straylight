# =============================================================================
# LOCAL DEV / CLAUDE CODE
# =============================================================================
CLAUDE.md
REVIEW_BACKLOG.md
${HOME}/

# =============================================================================
# TERRAFORM - CRITICAL: Prevents state files from being committed
# =============================================================================
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
terraform.rc
.terraformrc
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated by deployer.py - contains deployment-specific config
terraform/terraform.tfvars

# =============================================================================
# AWS & CLOUD CREDENTIALS - CRITICAL: Never commit these!
# =============================================================================
.aws/
*.pem
*.key
*.crt
*.p12
*.pfx
credentials
**/credentials
**/.aws/
aws-credentials.txt
ec2-user.pem
*.ppk

# =============================================================================
# ANSIBLE SENSITIVE FILES
# =============================================================================
ansible_vault_pass.txt
*.vault
group_vars/*/vault.yml
host_vars/*/vault.yml
inventory/vault*
*.retry

# Generated inventory files (use dynamic inventory instead)
ansible/inventory/hosts.yml
ansible/inventory/generated_*
ansible/inventory/*.json
ansible/inventory/*.ini

# Ansible fact cache and temp files
ansible/.ansible/
ansible/fact_cache/
ansible/tmp/

# Ansible cache/collections when ANSIBLE_HOME is set to repo root (or tooling creates it there)
.ansible/

# =============================================================================
# SSH KEYS & CERTIFICATES - CRITICAL
# =============================================================================
id_rsa*
id_ed25519*
id_ecdsa*
*.pub
known_hosts
authorized_keys

# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments (including uv's managed project environment)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.venv*/
.env*/
venv*/
env*/

# Python testing and build
.pytest_cache/
*.egg-info/
dist/
build/
.mypy_cache/
.coverage
htmlcov/
.tox/
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# =============================================================================
# IDE & EDITOR FILES
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.vim/
*.sublime-project
*.sublime-workspace

# =============================================================================
# OS FILES
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# LOGS & DEBUG FILES
# =============================================================================
*.log
*.out
*.err
debug.txt
trace.txt
crash.log

# =============================================================================
# BACKUP & TEMP FILES
# =============================================================================
*.bak
*.backup
*.tmp
*.temp
*~
.#*
\#*#

# =============================================================================
# C2 OPERATION SPECIFIC
# =============================================================================
# Payloads and tools (keep these out of version control!)
payloads/
tools/compiled/
loot/
screenshots/
evidence/
reports/*.pdf
reports/*.docx

# C2 assets pulled from GitHub (contains sensitive tools/configs)
ansible/files/c2-assets/

# Operation-specific configs (create templates instead)
**/current-operation.yml
**/target-*.txt
**/client-*.conf

# Generated SSL certificates and Apache backups (created by Ansible)
ansible/files/*.crt
ansible/files/*.key
ansible/files/*.pem
ansible/files/*.backup
ansible/files/*original*
**/apache2.conf.backup
**/apache2.conf.original
