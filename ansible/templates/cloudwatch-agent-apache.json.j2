{
  "agent": {
    "run_as_user": "root",
    "metrics_collection_interval": 60,
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/apache2/ssl_access.log",
            "log_group_name": "/aws/ec2/{{ operation_name }}/apache",
            "log_stream_name": "access-{instance_id}",
            "retention_in_days": {{ log_retention_days | default(90) }},
            "timestamp_format": "%d/%b/%Y:%H:%M:%S %z"
          },
          {
            "file_path": "/var/log/apache2/ssl_error.log",
            "log_group_name": "/aws/ec2/{{ operation_name }}/apache",
            "log_stream_name": "error-{instance_id}",
            "retention_in_days": {{ log_retention_days | default(90) }},
            "timestamp_format": "%a %b %d %H:%M:%S.%f %Y"
          }
        ]
      }
    },
    "log_stream_name": "redirector-{instance_id}",
    "force_flush_interval": 15
  }
}

