#!/bin/bash
set -euo pipefail

# Wireguard Setup Script - Generated by Ansible
# Operation: {{ operation_name }}
# Generated: {{ ansible_date_time.iso8601 if ansible_date_time is defined else 'unknown' }}

WIREGUARD_DIR="/etc/wireguard"
CLIENTS_DIR="${WIREGUARD_DIR}/clients"
INTERFACE="wg0"
NETWORK="10.8.0.0/24"
SERVER_IP="10.8.0.1"
PORT="51820"
OPERATION_NAME="{{ operation_name }}"

# Client configurations
declare -a CLIENTS=(
    "operator-1:10.8.0.2"
    "operator-2:10.8.0.3" 
    "operator-3:10.8.0.4"
    "operator-4:10.8.0.5"
    "operator-5:10.8.0.6"
)

echo "Setting up Wireguard VPN server for operation: ${OPERATION_NAME}..."

# Generate server keys if they don't exist
if [[ ! -f "${WIREGUARD_DIR}/private.key" ]]; then
    echo "Generating server keys..."
    wg genkey > "${WIREGUARD_DIR}/private.key"
    chmod 600 "${WIREGUARD_DIR}/private.key"
    wg pubkey < "${WIREGUARD_DIR}/private.key" > "${WIREGUARD_DIR}/public.key"
    chmod 644 "${WIREGUARD_DIR}/public.key"
fi

SERVER_PRIVATE_KEY=$(cat "${WIREGUARD_DIR}/private.key")
SERVER_PUBLIC_KEY=$(cat "${WIREGUARD_DIR}/public.key")

echo "Generating client keys..."

# Generate client keys and configurations
for client_config in "${CLIENTS[@]}"; do
    IFS=':' read -r client_name client_ip <<< "$client_config"
    
    echo "  Setting up ${client_name}..."
    
    # Generate client keys if they don't exist
    if [[ ! -f "${CLIENTS_DIR}/${client_name}.private" ]]; then
        wg genkey > "${CLIENTS_DIR}/${client_name}.private"
        chmod 600 "${CLIENTS_DIR}/${client_name}.private"
        wg pubkey < "${CLIENTS_DIR}/${client_name}.private" > "${CLIENTS_DIR}/${client_name}.public"
        chmod 600 "${CLIENTS_DIR}/${client_name}.public"
    fi
    

done

echo "Creating server configuration..."

# Get the external interface
EXTERNAL_INTERFACE=$(ip route | grep default | awk '{print $5}' | head -n1)
SERVER_ENDPOINT="{{ public_ip_address }}"

# Create server configuration
cat > "${WIREGUARD_DIR}/${INTERFACE}.conf" << EOF
[Interface]
PrivateKey = ${SERVER_PRIVATE_KEY}
Address = ${SERVER_IP}/24
ListenPort = ${PORT}
SaveConfig = false

# Enable IP forwarding
PostUp = echo 1 > /proc/sys/net/ipv4/ip_forward
PostUp = iptables -A FORWARD -i ${INTERFACE} -j ACCEPT
PostUp = iptables -A FORWARD -o ${INTERFACE} -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -o ${EXTERNAL_INTERFACE} -j MASQUERADE

PostDown = iptables -D FORWARD -i ${INTERFACE} -j ACCEPT
PostDown = iptables -D FORWARD -o ${INTERFACE} -j ACCEPT
PostDown = iptables -t nat -D POSTROUTING -o ${EXTERNAL_INTERFACE} -j MASQUERADE

EOF

# Add client configurations to server config
for client_config in "${CLIENTS[@]}"; do
    IFS=':' read -r client_name client_ip <<< "$client_config"
    
    if [[ -f "${CLIENTS_DIR}/${client_name}.public" ]]; then
        client_public_key=$(cat "${CLIENTS_DIR}/${client_name}.public")
        
        cat >> "${WIREGUARD_DIR}/${INTERFACE}.conf" << EOF
# ${client_name}
[Peer]
PublicKey = ${client_public_key}
AllowedIPs = ${client_ip}/32

EOF
    fi
done

echo "Creating client configurations..."

# Create client configuration files
for client_config in "${CLIENTS[@]}"; do
    IFS=':' read -r client_name client_ip <<< "$client_config"
    
    if [[ -f "${CLIENTS_DIR}/${client_name}.private" ]]; then
        client_private_key=$(cat "${CLIENTS_DIR}/${client_name}.private")
        
        cat > "${CLIENTS_DIR}/${client_name}.conf" << EOF
[Interface]
PrivateKey = ${client_private_key}
Address = ${client_ip}/24
DNS = 1.1.1.1, 8.8.8.8

[Peer]
PublicKey = ${SERVER_PUBLIC_KEY}
Endpoint = ${SERVER_ENDPOINT}:${PORT}
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
EOF
    fi
done

echo "Starting Wireguard service..."

# Enable and start Wireguard
systemctl enable wg-quick@${INTERFACE}
systemctl restart wg-quick@${INTERFACE}

echo "Wireguard setup complete!"
echo "Server status:"
wg show

echo "Creating client config archive..."
cd "${CLIENTS_DIR}"
tar -czf "/tmp/operator-configs-${OPERATION_NAME}.tar.gz" *.conf

echo "Setup complete! Client configs ready for upload to S3."
echo "Archive: /tmp/operator-configs-${OPERATION_NAME}.tar.gz" 